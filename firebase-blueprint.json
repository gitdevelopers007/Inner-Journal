{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and metadata",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "JournalEntry": {
      "title": "JournalEntry",
      "description": "A reflection or journal session belonging to a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "mood": { "type": "string" },
        "tags": { "type": "array" },
        "summary": { "type": "string" },
        "interactionCount": { "type": "number" },
        "isFavorite": { "type": "boolean" }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "Interaction": {
      "title": "Interaction",
      "description": "A conversational turn, reflection prompt, or Gemini response within a journal entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "entryId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "mode": { "type": "string", "enum": ["reflect", "brainstorm", "summarize", "deep-dive"] },
        "modelUsed": { "type": "string" }
      },
      "required": ["id", "entryId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Authenticated user's profile document"
    },
    "/users/{userId}/entries/{entryId}": {
      "schema": "JournalEntry",
      "description": "Private user journal entry"
    },
    "/users/{userId}/entries/{entryId}/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "Interactions and AI reflections belonging to a specific journal entry"
    },
    "/users/{userId}/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "Flat index of all user interactions for global history querying"
    }
  }
}
